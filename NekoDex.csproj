<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>NekoDex</RootNamespace>
    <AssemblyName>NekoDex</AssemblyName>
    <Product>NekoDex</Product>
    <AssemblyTitle>NekoDex</AssemblyTitle>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' != 'Release'">embedded</DebugType>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <SatelliteResourceLanguages>de;fr;es;it;pt;nl;pl;sv;da;nb;fi;cs;sk;hu;ro;bg;el;hr;sl;uk;ru;tr;zh-Hans;ja;ko</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Publish darf nur die eine EXE hinterlassen. Native Bibliotheken und Satelliten stecken im Bundle. -->
  <Target Name="FailOnPublishSidecars" AfterTargets="Publish">
    <ItemGroup>
      <_PublishSidecar Include="$(PublishDir)**\*" Exclude="$(PublishDir)$(AssemblyName).exe" />
    </ItemGroup>
    <Error Condition="'@(_PublishSidecar)' != ''"
           Text="Single-File-Publish darf nur $(AssemblyName).exe enthalten. Zusatzdateien: @(_PublishSidecar, ', ')" />
  </Target>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="System.IO.Compression" Version="4.3.0" />
  </ItemGroup>

</Project>
